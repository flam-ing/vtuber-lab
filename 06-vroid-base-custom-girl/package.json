{
  "name": "vroid-base-custom-girl",
  "private": true,
  "version": "0.2.0",
  "description": "vtuber-lab/06 — VRoid/VRM 3D desktop VTuber (full-body MediaPipe + Electron transparent panel). Formerly mingo-mate / slot 04.",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5183 --strictPort\" \"node scripts/wait-and-electron.mjs\"",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "start": "npm run build && electron .",
    "shot": "node scripts/screenshot.mjs",
    "dist": "npm run build && electron-builder --mac dmg",
    "dist:dir": "npm run build && electron-builder --mac dir",
    "dist:dmg": "bash scripts/pack-dmg.sh"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@pixiv/three-vrm": "^3.5.5",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@types/three": "^0.185.1",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "build": {
    "appId": "com.minwoo19930301.mingomate",
    "productName": "MingoMate",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/**/*.wasm",
      "dist/**/*.task",
      "dist/**/*.vrm"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSCameraUsageDescription": "MingoMate uses the camera locally to track your face, body, and hands for the avatar.",
        "NSMicrophoneUsageDescription": "Not used."
      }
    },
    "dmg": {
      "title": "MingoMate ${version}",
      "writeUpdateInfo": false
    }
  }
}
